// ARQUIVO GERADO por scripts/gerar-schema-sqlserver.ts - NÃO EDITE.
// Edite prisma/schema.prisma e rode `npm run schema:sqlserver`.

// Schema principal (MySQL - desenvolvimento local).
//
// A versão SQL Server (homologação/produção no Azure) é GERADA a partir deste
// arquivo com `npm run schema:sqlserver`. Nunca edite prisma/sqlserver/schema.prisma
// manualmente.
//
// Regras de portabilidade MySQL <-> SQL Server:
//  - Não usar `enum` (SQL Server não suporta): status/perfis são String validados na API.
//  - Tipos nativos permitidos: @db.NVarChar(n) e @db.NVarChar(Max) (convertidos para NVarChar).
//  - Relações com onDelete/onUpdate NoAction (SQL Server não aceita múltiplos caminhos de cascade).

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.NVarChar(150)
  email        String   @unique @db.NVarChar(191)
  senhaHash    String   @map("senha_hash") @db.NVarChar(255)
  /// ADMIN | GESTOR | COLABORADOR
  perfil       String   @default("COLABORADOR") @db.NVarChar(20)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  boasPraticasAutor     BoaPratica[]          @relation("Autor")
  boasPraticasAprovador BoaPratica[]          @relation("Aprovador")
  historico             HistoricoBoaPratica[]

  @@map("usuarios")
}

model Categoria {
  id           Int      @id @default(autoincrement())
  nome         String   @unique @db.NVarChar(100)
  descricao    String?  @db.NVarChar(500)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  boasPraticas BoaPratica[]

  @@map("categorias")
}

model BoaPratica {
  id           Int       @id @default(autoincrement())
  titulo       String    @db.NVarChar(200)
  resumo       String    @db.NVarChar(500)
  conteudo     String    @db.NVarChar(Max)
  /// RASCUNHO | EM_REVISAO | DEVOLVIDA | PUBLICADA | ARQUIVADA
  status       String    @default("RASCUNHO") @db.NVarChar(20)
  categoriaId  Int       @map("categoria_id")
  autorId      Int       @map("autor_id")
  aprovadorId  Int?      @map("aprovador_id")
  publicadaEm  DateTime? @map("publicada_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  categoria Categoria             @relation(fields: [categoriaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  autor     Usuario               @relation("Autor", fields: [autorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aprovador Usuario?              @relation("Aprovador", fields: [aprovadorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historico HistoricoBoaPratica[]

  @@index([status])
  @@index([categoriaId])
  @@index([autorId])
  @@map("boas_praticas")
}

/// Trilha de auditoria do fluxo de aprovação.
model HistoricoBoaPratica {
  id           Int      @id @default(autoincrement())
  boaPraticaId Int      @map("boa_pratica_id")
  usuarioId    Int      @map("usuario_id")
  /// CRIACAO | EDICAO | ENVIO_REVISAO | APROVACAO | DEVOLUCAO | ARQUIVAMENTO
  acao         String   @db.NVarChar(30)
  statusDe     String?  @map("status_de") @db.NVarChar(20)
  statusPara   String   @map("status_para") @db.NVarChar(20)
  comentario   String?  @db.NVarChar(1000)
  criadoEm     DateTime @default(now()) @map("criado_em")

  boaPratica BoaPratica @relation(fields: [boaPraticaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([boaPraticaId])
  @@map("historico_boas_praticas")
}
