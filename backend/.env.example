# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# Banco de dados: mysql (local) | sqlserver (homologação/produção Azure)
DB_PROVIDER=mysql
DATABASE_URL="mysql://root:root@localhost:3306/boaspraticas?allowPublicKeyRetrieval=true"
# Exemplo SQL Server (Azure SQL):
# DB_PROVIDER=sqlserver
# DATABASE_URL="sqlserver://seu-servidor.database.windows.net:1433;database=boaspraticas;user=usuario;password=senha;encrypt=true;trustServerCertificate=false"

# Autenticação (gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-este-segredo-em-producao-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Banco usado pelos testes de integração (npm test). Deixe vazio para rodar só os testes unitários.
DATABASE_URL_TEST="mysql://root:root@localhost:3306/boaspraticas_test?allowPublicKeyRetrieval=true"

# Pasta do build do frontend servida pela API (produção). Relativa à pasta backend/.
FRONTEND_DIST=../frontend/dist
